# WeChatBridge environment configuration
#
# Place this file at:
#   ~/.config/wechatbridge/<instance>.env     (per-instance)
#   ~/.config/wechatbridge/.env               (default, shared across instances)
#
# Or point to it explicitly with $WECHATBRIDGE_ENV_FILE.
# The old location (repository root .env) is deprecated and will show a warning.
#
# Uncomment and adjust values for your deployment. Defaults are shown.

# --- iLink (WeChat bot API) ---
# Base URL for the iLink API.
# ILINK_BASE_URL=https://ilinkai.weixin.qq.com

# agy CLI binary path. If empty or "agy", assumes in PATH.
# AGY_BIN_PATH=agy

# grok (Grok Build) CLI binary path. If empty or "grok", assumes in PATH.
# GROK_BIN_PATH=grok

# codex (OpenAI Codex) CLI binary path. If empty or "codex", assumes in PATH.
# CODEX_BIN_PATH=codex

# Active CLI backend: "agy", "grok", or "codex". Can be switched per-user via /backend command.
# WECHATBRIDGE_BACKEND=agy

# --- Storage paths ---
# Instance name for multi-instance deployments.
# All per-instance paths (state/session/qrcode) derive from this.
# WECHATBRIDGE_INSTANCE=default

# Per-user session workspace directory
# (default: ~/.local/share/wechatbridge/<instance>/sessions).
# WECHATBRIDGE_SESSION_DIR=

# Bot token persistence file
# (default: ~/.local/share/wechatbridge/<instance>/.ilink_state.json).
# WECHATBRIDGE_STATE_FILE=

# QR code image save path (for login).
# (default: ~/.local/share/wechatbridge/<instance>/qrcode.png)
# WECHATBRIDGE_QRCODE_PATH=

# QR code URL file path (for external access).
# (default: ~/.local/share/wechatbridge/<instance>/.current_qrcode_url.txt)
# WECHATBRIDGE_QRCODE_URL_FILE=

# --- Timeouts ---
# CLI execution timeout (seconds). Default: 600 (10 minutes).
# AGY_TIMEOUT=600

# QR code polling timeout (seconds).
# QRCODE_POLL_TIMEOUT=180

# QR code poll interval (seconds).
# QRCODE_POLL_INTERVAL=1.5

# CDN upload timeout (seconds).
# CDN_UPLOAD_TIMEOUT=120

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO

# --- Media ---
# iLink CDN base URL for image download.
# WECHATBRIDGE_CDN_BASE=https://novac2c.cdn.weixin.qq.com/c2c

# agy scratch directory — where agy writes generated files.
# AGY_SCRATCH_DIR=~/.gemini/antigravity-cli/scratch

# Global agy scratch retention days (TTL cleanup).
# AGY_SCRATCH_RETENTION_DAYS=7

# Per-session temp cleanup days: media, caches, scratch/logs (not chat history).
# Default = same as AGY_SCRATCH_RETENTION_DAYS.
# WECHATBRIDGE_SESSION_RETENTION_DAYS=7

# Dialogue history idle TTL (days). Files not touched this long are deleted
# (agy conversations/brain, grok sessions). Active chats keep updating mtime.
# Prefs/auth are never deleted. Default 30.
# WECHATBRIDGE_HISTORY_RETENTION_DAYS=30

# Maximum outbound file size in bytes. 100 MB default (Tencent OpenClaw SDK limit).
# WECHATBRIDGE_MAX_OUTBOUND_BYTES=104857600

# Maximum inbound image/file size in bytes. 20 MB default.
# WECHATBRIDGE_MAX_INBOUND_BYTES=20971520

# Global concurrent process slots (across users). Same user is serial: later
# messages queue without holding a global slot; only one slot per user while
# actually processing. When all global slots are busy, extras get a busy reply.
# WECHATBRIDGE_MAX_CONCURRENT=4

# Long reply chunk size (characters) when splitting WeChat text.
# WECHATBRIDGE_MESSAGE_CHUNK=2000

# Extra absolute roots allowed for /add-dir (comma-separated).
# Session directory is always allowed. Empty = only session dir.
# WECHATBRIDGE_ADD_DIR_ROOTS=

# --- Access control ---
# Comma-separated WeChat user IDs allowed to use the bridge. Empty = allow all.
# WECHATBRIDGE_ALLOWED_SENDERS=

# Enable /mcp slash command (agy MCP tool guidance).
# WECHATBRIDGE_ENABLE_MCP=true

# Enable /agent slash command (subagent invocation).
# WECHATBRIDGE_ENABLE_SUBAGENT=true

# --- Dangerous prompt confirmation ---
# Comma-separated custom dangerous keywords. Empty = use built-in list
# (shell/destructive patterns; bare words like「删除」are NOT in the default list).
# WECHATBRIDGE_CONFIRM_KEYWORDS=

# Pending confirmation TTL (seconds).
# WECHATBRIDGE_PENDING_TTL=300

# Confirmation keyword user must reply to execute a dangerous prompt.
# WECHATBRIDGE_CONFIRM_TOKEN=y

# --- Update check ---
# Comma-separated wxid list of admin users who receive a WeChat notification
# when a new version is detected on PyPI.
# WECHATBRIDGE_ADMINS=

# Enable automatic PyPI version check on startup and every 24 hours.
# When a new version is found, it is logged and admins (WECHATBRIDGE_ADMINS) are notified.
# Set to "false" to disable.
# WECHATBRIDGE_UPDATE_CHECK=true

# Interval in seconds between version checks. Default: 86400 (24 hours).
# WECHATBRIDGE_UPDATE_CHECK_INTERVAL=86400
